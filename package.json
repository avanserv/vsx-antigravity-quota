{
  "name": "antigravity-quota",
  "displayName": "Antigravity Quota",
  "description": "Displays Antigravity quota and usage in the status bar.",
  "publisher": "avanserv",
  "repository": {
    "type": "git",
    "url": "https://github.com/avanserv/vsx-antigravity-quota.git"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-quota-container",
          "title": "Antigravity Quota",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-quota-container": [
        {
          "type": "webview",
          "id": "antigravity-quota-sidebar",
          "name": "Quota Dashboard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity-quota.showDetails",
        "title": "Show Quota Details"
      },
       {
        "command": "antigravity-quota.refresh",
        "title": "Refresh Quota"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^9.9.1",
    "typescript": "^5.5.4",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  },
  "dependencies": {
    "axios": "^1.7.9"
  }
}
